# cmake -P tools/package.cmake; add -DSOURCE_ONLY=ON before -P for source only.
cmake_minimum_required(VERSION 3.20)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(out "${root}/output")
set(stage "${root}/build-package-stage")
file(REMOVE_RECURSE "${stage}")
file(MAKE_DIRECTORY "${stage}/Baikonur_Source/output" "${out}")
foreach(name CMakeLists.txt README.md CREDITS.md .gitignore .clang-format run.command .github src assets shaders tests vendor tools docs)
 file(COPY "${root}/${name}" DESTINATION "${stage}/Baikonur_Source" PATTERN ".DS_Store" EXCLUDE PATTERN ".git" EXCLUDE)
endforeach()
file(WRITE "${stage}/Baikonur_Source/output/.gitkeep" "")
function(zip_directory directory destination)
 execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${destination}.pending.zip" --format=zip . WORKING_DIRECTORY "${directory}" RESULT_VARIABLE result)
 if(NOT result EQUAL 0)
  message(FATAL_ERROR "Archive creation failed: ${destination}")
 endif()
 file(RENAME "${destination}.pending.zip" "${destination}")
endfunction()
zip_directory("${stage}" "${out}/Baikonur_Source.zip")
# Verify the complete extracted source against staging.
file(MAKE_DIRECTORY "${stage}-verify")
file(ARCHIVE_EXTRACT INPUT "${out}/Baikonur_Source.zip" DESTINATION "${stage}-verify")
file(GLOB_RECURSE members RELATIVE "${stage}" "${stage}/*")
foreach(member IN LISTS members)
 file(SHA256 "${stage}/${member}" expected)
 file(SHA256 "${stage}-verify/${member}" actual)
 if(NOT expected STREQUAL actual)
  message(FATAL_ERROR "Archive mismatch: ${member}")
 endif()
endforeach()
file(REMOVE_RECURSE "${stage}" "${stage}-verify")
if(NOT SOURCE_ONLY)
 # Refresh the local macOS backup only on its supported host.
 if(CMAKE_HOST_APPLE AND CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "arm64|aarch64")
  if(NOT DEFINED BUILD_DIR)
   set(BUILD_DIR "${root}/build")
  endif()
  set(backup "${stage}/Baikonur_macOS_AppleSilicon")
  file(MAKE_DIRECTORY "${backup}")
  foreach(name baikonur assets shaders)
   file(COPY "${BUILD_DIR}/${name}" DESTINATION "${backup}")
  endforeach()
  foreach(name CREDITS.md vendor/glfw/LICENSE.md vendor/glm/copying.txt vendor/imgui/LICENSE.txt)
   get_filename_component(parent "${name}" DIRECTORY)
   file(COPY "${root}/${name}" DESTINATION "${backup}/${parent}")
  endforeach()
  file(WRITE "${backup}/Launch.command" "#!/bin/sh\ncd \"$(dirname \"$0\")\" || exit 1\nexec ./baikonur \"$@\"\n")
  file(CHMOD "${backup}/Launch.command" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  file(WRITE "${backup}/README.txt" "Apple Silicon macOS offline backup. Keep assets and shaders beside the executable. Double-click Launch.command. This executable is unsigned.\n")
  zip_directory("${stage}" "${out}/Baikonur_macOS_AppleSilicon.zip")
  file(REMOVE_RECURSE "${stage}")
 endif()
 file(MAKE_DIRECTORY "${stage}")
 set(files Baikonur_Source.zip Baikonur_Report.docx pdf/Baikonur_Report.pdf Baikonur_Presentation.pptx Baikonur_Demo_1080p.mp4)
 if(EXISTS "${out}/Baikonur_macOS_AppleSilicon.zip")
  list(APPEND files Baikonur_macOS_AppleSilicon.zip)
 endif()
 set(manifest "")
 foreach(name IN LISTS files)
  file(SHA256 "${out}/${name}" hash)
  get_filename_component(basename "${name}" NAME)
  string(APPEND manifest "${hash}  ${basename}\n")
  file(COPY "${out}/${name}" DESTINATION "${stage}")
 endforeach()
 file(WRITE "${out}/SHA256SUMS.txt" "${manifest}")
 file(COPY "${out}/SHA256SUMS.txt" "${out}/START_HERE.txt" "${root}/docs/REQUIREMENTS_CHECKLIST.md" DESTINATION "${stage}")
 zip_directory("${stage}" "${out}/Baikonur_Submission_Package.zip")
 file(REMOVE_RECURSE "${stage}")
endif()
message(STATUS "Packaged deliverables; source archive verified byte-for-byte.")
